{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "production"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "env": {
          "EAS_USE_CACHE": "1",
          "USE_CCACHE": "1"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
